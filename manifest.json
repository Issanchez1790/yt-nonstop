{
  "manifest_version": 3,
  "name": "YT NonStop",
  "version": "1.0.0",
  "description": "Evita la pausa 'Video en pausa. ¿Quieres seguir viendo?' en YouTube y YouTube Music.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
